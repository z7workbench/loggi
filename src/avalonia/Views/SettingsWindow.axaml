<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:top.z7workbench.loggi.Converters"
        x:Class="top.z7workbench.loggi.Views.SettingsWindow"
        Title="{converters:Localization SettingsTitle}"
        Width="800" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
  <Window.Styles>
    <Style Selector="Button.selected">
      <Setter Property="Background" Value="{DynamicResource SelectedButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource SelectedButtonForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SelectedButtonBackground}" />
    </Style>
    <Style Selector="Button /template/ ContentPresenter:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
    </Style>
    <Style Selector="Button:not(.selected) /template/ ContentPresenter:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource SelectedButtonForeground}" />
    </Style>
    
    <!-- More specific styles to override Fluent theme for better contrast in both light and dark modes -->
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource SelectedButtonForeground}" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SelectedButtonForeground}" />
    </Style>
    <Style Selector="CheckBox /template/ ToggleButton#PART_CheckedIndicator:pointerover /template/ Rectangle">
      <Setter Property="Fill" Value="{DynamicResource SecondaryBrush}" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#DropDownBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}" />
    </Style>
  </Window.Styles>
  
  <Grid ColumnDefinitions="200, *" Margin="15" Background="{DynamicResource MainBackgroundBrush}">
    <!-- Left sidebar for navigation -->
    <Border Grid.Column="0" Background="{DynamicResource NavigationSidebarBackground}" CornerRadius="4" BorderBrush="{DynamicResource NavigationSidebarBorder}" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Name="NavigationPanel" Margin="10">
          <TextBlock Text="{converters:Localization SettingsDisplay}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="{DynamicResource NavigationButtonForeground}" />
          <Button Name="FontSettingsButton" Content="{converters:Localization SettingsFontSettings}" 
                  Margin="0,0,0,5" 
                  Height="30" 
                  HorizontalAlignment="Stretch" 
                  HorizontalContentAlignment="Left"
                  Padding="10,0,0,0"
                  Tag="FontSettings" 
                  BorderThickness="0" 
                  Background="Transparent"
                  Foreground="{DynamicResource NavigationButtonForeground}"
                  Classes="selected"
                  Click="CategoryButton_Click" />
          <Button Name="ViewOptionsButton" Content="{converters:Localization SettingsViewOptions}" 
                  Margin="0,0,0,5" 
                  Height="30" 
                  HorizontalAlignment="Stretch" 
                  HorizontalContentAlignment="Left"
                  Padding="10,0,0,0"
                  Tag="ViewOptions" 
                  BorderThickness="0" 
                  Background="Transparent"
                  Foreground="{DynamicResource NavigationButtonForeground}"
                  Click="CategoryButton_Click" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Main content area -->
    <Grid Grid.Column="1" RowDefinitions="*, Auto" Background="{DynamicResource MainBackgroundBrush}">
      <!-- Scrollable content area -->
      <ScrollViewer Name="ContentScrollViewer" Grid.Row="0" 
                    VerticalScrollBarVisibility="Auto" 
                    HorizontalScrollBarVisibility="Disabled" 
                    Margin="15,0,0,0"
                    Background="{DynamicResource MainBackgroundBrush}">
        <StackPanel Margin="0,0,10,0" Background="{DynamicResource MainBackgroundBrush}">
          <TextBlock Text="{converters:Localization SettingsFontSettings}" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource TextBrush}" />
          
          <StackPanel Orientation="Vertical" Margin="0,0,0,10" Background="{DynamicResource MainBackgroundBrush}">
            <TextBlock Text="{converters:Localization SettingsFontSize}" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource TextBrush}" />
            <NumericUpDown Value="{Binding FontSize, Mode=TwoWay}" 
                           Minimum="8" Maximum="72" 
                           Width="100" HorizontalAlignment="Left"
                           Background="{DynamicResource SearchBoxBackground}"
                           Foreground="{DynamicResource SearchBoxForeground}"
                           BorderBrush="{DynamicResource SearchBoxBorder}" />
          </StackPanel>
          
          <StackPanel Orientation="Vertical" Margin="0,0,0,10" Background="{DynamicResource MainBackgroundBrush}">
            <TextBlock Text="{converters:Localization SettingsFontFamily}" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource TextBrush}" />
            <ComboBox ItemsSource="{Binding AvailableFonts}" 
                      SelectedItem="{Binding FontFamily, Mode=TwoWay}"
                      HorizontalAlignment="Left" 
                      MinWidth="150"
                      MaxWidth="300"
                      Background="{DynamicResource SearchBoxBackground}"
                      Foreground="{DynamicResource SearchBoxForeground}"
                      BorderBrush="{DynamicResource SearchBoxBorder}" />
          </StackPanel>
          
          <StackPanel Orientation="Vertical" Margin="0,0,0,10" Background="{DynamicResource MainBackgroundBrush}">
            <TextBlock Text="{converters:Localization SettingsLineHeight}" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource TextBrush}" />
            <NumericUpDown Value="{Binding LineHeight, Mode=TwoWay}" 
                           Minimum="0.5" Maximum="3.0" 
                           Increment="0.1"
                           Width="100" HorizontalAlignment="Left"
                           Background="{DynamicResource SearchBoxBackground}"
                           Foreground="{DynamicResource SearchBoxForeground}"
                           BorderBrush="{DynamicResource SearchBoxBorder}" />
          </StackPanel>
          
          <Border BorderBrush="{DynamicResource SeparatorBorder}" BorderThickness="0,1,0,0" Margin="0,15,0,15" />
          
          <TextBlock Text="{converters:Localization SettingsViewOptionsTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource TextBrush}" />
          
          <StackPanel Orientation="Vertical" Margin="0,0,0,10" Background="{DynamicResource MainBackgroundBrush}">
            <CheckBox Content="{converters:Localization SettingsShowLineNumbers}" 
                      IsChecked="{Binding ShowLineNumbers, Mode=TwoWay}"
                      Foreground="{DynamicResource TextBrush}" />
            <CheckBox Content="{converters:Localization SettingsWordWrap}" 
                      IsChecked="{Binding WordWrap, Mode=TwoWay}" Margin="0,5,0,0"
                      Foreground="{DynamicResource TextBrush}" />
          </StackPanel>
          
          <Border BorderBrush="{DynamicResource SeparatorBorder}" BorderThickness="0,1,0,0" Margin="0,15,0,15" />
          
          <TextBlock Text="{converters:Localization LanguageLabel}" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource TextBrush}" />
          
          <StackPanel Orientation="Vertical" Margin="0,0,0,10" Background="{DynamicResource MainBackgroundBrush}">
            <TextBlock Text="{converters:Localization LanguageLabel}" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource TextBrush}" />
            <ComboBox ItemsSource="{Binding AvailableLanguages}" 
                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                      HorizontalAlignment="Left" 
                      MinWidth="150"
                      MaxWidth="300"
                      Background="{DynamicResource SearchBoxBackground}"
                      Foreground="{DynamicResource SearchBoxForeground}"
                      BorderBrush="{DynamicResource SearchBoxBorder}" />
          </StackPanel>
          
          <Border BorderBrush="{DynamicResource SeparatorBorder}" BorderThickness="0,1,0,0" Margin="0,15,0,15" />
          
          <TextBlock Text="{converters:Localization SettingsThemeTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource TextBrush}" />
          
          <StackPanel Orientation="Vertical" Margin="0,0,0,10" Background="{DynamicResource MainBackgroundBrush}">
            <TextBlock Text="{converters:Localization SettingsThemeLabel}" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource TextBrush}" />
            <ComboBox ItemsSource="{Binding AvailableThemes}" 
                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                      HorizontalAlignment="Left" 
                      MinWidth="150"
                      MaxWidth="300"
                      Background="{DynamicResource SearchBoxBackground}"
                      Foreground="{DynamicResource SearchBoxForeground}"
                      BorderBrush="{DynamicResource SearchBoxBorder}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>