<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:top.z7workbench.loggi"
             xmlns:converters="using:top.z7workbench.loggi.Converters"
             x:Class="top.z7workbench.loggi.App">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <!-- ZeroGo's Dark Theme (default) -->
        <!-- General Colors -->
        <Color x:Key="PrimaryColor">#583dbf</Color>
        <Color x:Key="SecondaryColor">#cd6e1c</Color>
        <Color x:Key="MainBackground">#1e1e1e</Color>
        <Color x:Key="TextColor">#FFFFFF</Color>
        <Color x:Key="NonPrimaryBackground">#404040</Color>
        <Color x:Key="SeparatorColor">#EDEDED</Color>

        <!-- Brush Resources -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
        <SolidColorBrush x:Key="MainBackgroundBrush" Color="{StaticResource MainBackground}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="NonPrimaryBackgroundBrush" Color="{StaticResource NonPrimaryBackground}" />
        <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}" />

        <!-- UI Specific Colors -->
        <SolidColorBrush x:Key="StatusBarBackground" Color="#583dbf" />
        <SolidColorBrush x:Key="SectionHeaderBackground" Color="#404040" />
        <SolidColorBrush x:Key="MainContentBackground" Color="#1e1e1e" />
        <SolidColorBrush x:Key="LineNumberForeground" Color="#404040" />
        <SolidColorBrush x:Key="SearchBoxBackground" Color="#2d2d30" />
        <SolidColorBrush x:Key="SearchBoxForeground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SearchBoxBorder" Color="#583dbf" />
        <SolidColorBrush x:Key="SearchButtonBackground" Color="#583dbf" />
        <SolidColorBrush x:Key="SearchButtonForeground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ClearButtonBackground" Color="#cd6e1c" />
        <SolidColorBrush x:Key="ClearButtonForeground" Color="#FFFFFF" />

        <!-- Settings Window Colors -->
        <SolidColorBrush x:Key="NavigationSidebarBackground" Color="#404040" />
        <SolidColorBrush x:Key="NavigationSidebarBorder" Color="#583dbf" />
        <SolidColorBrush x:Key="NavigationButtonForeground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SelectedButtonBackground" Color="#583dbf" />
        <SolidColorBrush x:Key="SelectedButtonForeground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ButtonHoverBackground" Color="#cd6e1c" />
        <SolidColorBrush x:Key="SeparatorBorder" Color="#EDEDED" />
        
        <!-- System Colors -->
        <SolidColorBrush x:Key="SystemControlBackgroundBrush" Color="#2d2d30" />
        <SolidColorBrush x:Key="SystemControlForegroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SystemControlBorderBrush" Color="#583dbf" />
        
        <!-- Window Title Bar Colors for Dark Theme -->
        <Color x:Key="SystemChromeBackgroundColor">#1e1e1e</Color>
        <Color x:Key="SystemChromeForegroundColor">#ffffff</Color>
        <Color x:Key="SystemChromeMediumColor">#2d2d30</Color>
        <Color x:Key="SystemChromeHighColor">#3f3f46</Color>
        <SolidColorBrush x:Key="SystemChromeBackgroundBrush" Color="{StaticResource SystemChromeBackgroundColor}" />
        <SolidColorBrush x:Key="SystemChromeForegroundBrush" Color="{StaticResource SystemChromeForegroundColor}" />
        <SolidColorBrush x:Key="SystemChromeMediumBrush" Color="{StaticResource SystemChromeMediumColor}" />
        <SolidColorBrush x:Key="SystemChromeHighBrush" Color="{StaticResource SystemChromeHighColor}" />
        
        <converters:HighlightConverter x:Key="HighlightConverter" />
    </Application.Resources>
</Application>